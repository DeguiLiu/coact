# Build directories
build_*/
build-*/
build/

# Object files left in-tree by ad-hoc toolchain runs (e.g. QEMU BSP bring-up)
*.o

# Editor artifacts
*.swp
*.swo
*~
# OS artifacts
.DS_Store

# Local-only material: the blog series stays on disk but is not published
docs/blogs/

# One-off artifacts: run logs and backups are not part of the published docs
docs/*run_log*.txt
docs/**/*.bak

# Local-only material: the pipeline design docs stay on disk but are not
# published (they describe a specific product bring-up, not the framework)
docs/example_isp_pipeline_design_zh.md
docs/isp_pipeline_document_editing_guide_zh.md
